<div class="max-w-md mx-auto">
  <div class="mb-6">
    <%= link_to "← Retour à la partie", game_path(@game), class: "text-gray-400 hover:neon-text-cyan transition-all duration-300" %>
  </div>

  <div class="neon-border p-6">
    <h1 class="text-2xl font-display font-bold neon-text-pink mb-4">Ma proposition</h1>
    
    <div class="bg-neon-cyan/10 border border-neon-cyan/30 rounded-lg p-4 mb-4">
      <div class="flex items-center gap-3 neon-text-cyan mb-2">
        <span class="text-xl">✅</span>
        <span class="font-medium">Proposition soumise</span>
      </div>
      <p class="text-sm text-gray-400">
        Soumise le <%= @proposal.created_at.strftime("%d/%m/%Y à %H:%M") %>
      </p>
    </div>

    <div class="border border-neon-purple/30 rounded-lg p-4 bg-dark-700/50">
      <h3 class="text-sm font-medium text-gray-400 mb-2">Lien musical:</h3>
      <a href="<%= @proposal.url %>" target="_blank" rel="noopener noreferrer" class="neon-text-cyan hover:neon-text-pink transition-all duration-300 break-all">
        <%= @proposal.url %>
      </a>
    </div>

    <div class="mt-6 text-center">
      <p class="text-sm text-gray-500">
        Votre proposition est enregistrée et invisible aux autres joueurs.<br>
        Attendez que l'organisateur lance la phase de devinettes.
      </p>
    </div>
  </div>
</div>
