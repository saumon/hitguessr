<div class="max-w-md mx-auto">
  <div class="mb-6">
    <%= link_to "← Retour à la partie", game_path(@game), class: "text-gray-400 hover:neon-text-cyan transition-all duration-300" %>
  </div>

  <div class="neon-border p-6">
    <h1 class="text-2xl font-display font-bold neon-text-pink mb-4">🎵 Soumettre ma musique</h1>
    
    <p class="text-gray-300 mb-6">
      Partagez le lien vers une musique que vous aimez. Les autres joueurs devront deviner que c'est vous qui l'avez proposée !
    </p>

    <%= form_with model: [@game, @proposal], class: "space-y-4" do |f| %>
      <% if @proposal.errors.any? %>
        <div class="bg-red-500/10 border border-red-500/30 text-red-400 px-4 py-3 rounded-lg">
          <h2 class="font-medium"><%= pluralize(@proposal.errors.count, "erreur") %> empêche<%= @proposal.errors.count > 1 ? "nt" : "" %> la sauvegarde:</h2>
          <ul class="list-disc list-inside mt-2 text-sm">
            <% @proposal.errors.each do |error| %>
              <li><%= error.full_message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= f.label :url, "Lien vers la musique", class: "block text-sm font-medium text-gray-300 mb-2" %>
        <%= f.url_field :url, class: "input-neon w-full", placeholder: "https://www.youtube.com/watch?v=...", required: true %>
        <p class="text-xs text-gray-500 mt-2">YouTube, Spotify, Deezer, SoundCloud... tout lien musical valide</p>
      </div>

      <div class="bg-yellow-500/10 border border-yellow-500/30 rounded-lg p-3">
        <p class="text-sm text-yellow-400">
          ⚠️ <strong>Attention:</strong> Votre proposition sera invisible aux autres joueurs jusqu'à la phase de devinettes.
        </p>
      </div>

      <div>
        <%= f.submit "Soumettre ma proposition", class: "btn-neon btn-primary w-full font-medium py-2 px-4 rounded-lg cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
