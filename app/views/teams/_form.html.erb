<%= form_with model: team, class: "space-y-4" do |f| %>
  <% if team.errors.any? %>
    <div class="bg-dark-700/90 border border-neon-pink/50 text-neon-pink px-4 py-3 rounded-lg">
      <h2 class="font-medium"><%= pluralize(team.errors.count, "erreur") %> empêche<%= team.errors.count > 1 ? "nt" : "" %> la sauvegarde:</h2>
      <ul class="list-disc list-inside mt-2 text-sm text-gray-300">
        <% team.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, "Nom de l'équipe", class: "block text-sm font-medium text-gray-300 mb-1" %>
    <%= f.text_field :name, class: "input-neon w-full px-4 py-3 bg-dark-700 border border-dark-500 rounded-lg text-gray-100 placeholder-gray-500 focus:outline-none transition-all duration-300", placeholder: "Ex: Les Mélomanes", required: true, minlength: 2, maxlength: 100 %>
    <p class="text-xs text-gray-500 mt-1">Entre 2 et 100 caractères</p>
  </div>

  <div>
    <%= f.submit team.persisted? ? "Mettre à jour" : "Créer l'équipe", class: "btn-neon w-full bg-gradient-to-r from-neon-cyan to-neon-purple text-white font-semibold py-3 px-4 rounded-lg transition-all duration-300 cursor-pointer hover:shadow-lg hover:shadow-neon-cyan/30" %>
  </div>
<% end %>
