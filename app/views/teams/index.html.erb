<div class="max-w-4xl mx-auto">
  <div class="flex justify-between items-center mb-8">
    <h1 class="font-display text-3xl font-bold neon-text-cyan">Mes Équipes</h1>
    <%= link_to new_team_path, class: "btn-neon btn-primary px-6 py-3 rounded-lg font-medium flex items-center gap-2" do %>
      <span>+</span> Créer une équipe
    <% end %>
  </div>

  <% if @teams.empty? %>
    <div class="neon-border p-10 text-center">
      <div class="text-5xl mb-4 pulse-glow">🎵</div>
      <p class="text-gray-500 mb-4">Vous n'avez pas encore d'équipe.</p>
      <%= link_to "Créer ma première équipe", new_team_path, class: "neon-text-cyan hover:neon-text-pink font-medium transition-all duration-300" %>
    </div>
  <% else %>
    <div class="space-y-4">
      <% @teams.each do |team| %>
        <div class="neon-border p-6 hover:scale-[1.02] transition-transform duration-300">
          <div class="flex justify-between items-start">
            <div>
              <div class="flex items-center gap-3">
                <span class="text-3xl pulse-glow neon-text-pink">♫</span>
                <h2 class="font-display text-xl font-semibold neon-text-pink"><%= team.name %></h2>
              </div>
              <p class="text-gray-400 mt-2">
                Organisateur: <span class="neon-text-cyan"><%= team.organizer == current_user ? "Moi" : team.organizer.name %></span>
              </p>
              <p class="text-sm text-gray-500 mt-1">
                <%= pluralize(team.members.count, "membre") %> • <%= pluralize(team.games.count, "partie") %> jouée<%= team.games.count > 1 ? "s" : "" %>
              </p>
            </div>
            <div class="flex gap-3">
              <%= link_to "Voir", team, class: "btn-neon btn-secondary px-4 py-2 rounded-lg text-sm" %>
              <%= link_to "Jouer", new_team_game_path(team), class: "btn-neon btn-primary px-4 py-2 rounded-lg text-sm" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
