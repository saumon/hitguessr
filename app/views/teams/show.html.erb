<div class="max-w-4xl mx-auto">
  <%# Header %>
  <div class="flex justify-between items-center mb-8">
    <div class="flex items-center gap-4">
      <%= link_to "← Retour", teams_path, class: "neon-text-cyan hover:neon-text-pink transition-all duration-300" %>
      <h1 class="font-display text-2xl font-bold neon-text-pink"><%= @team.name %></h1>
    </div>
    <% if @team.organizer == current_user %>
      <div class="flex gap-2">
        <%= link_to "Éditer", edit_team_path(@team), class: "btn-neon btn-secondary px-4 py-2 rounded-lg text-sm" %>
        <%= button_to "Supprimer", team_path(@team), method: :delete, data: { turbo_confirm: "Êtes-vous sûr de vouloir supprimer cette équipe ?" }, class: "btn-neon btn-danger px-4 py-2 rounded-lg text-sm cursor-pointer" %>
      </div>
    <% end %>
  </div>

  <%# Team Info %>
  <div class="neon-border p-6 mb-6">
    <p class="text-gray-400">
      <span class="font-medium text-gray-300">Organisateur:</span> <span class="neon-text-cyan"><%= @team.organizer.name %></span>
    </p>
  </div>

  <%# Members Section %>
  <div class="neon-border p-6 mb-6">
    <h2 class="font-display text-lg font-semibold neon-text-cyan mb-4">Membres (<%= @members.count %>)</h2>
    
    <div class="space-y-2">
      <% @members.each do |member| %>
        <div class="flex justify-between items-center py-3 border-b border-neon-purple/20 last:border-0">
          <div class="flex items-center gap-3">
            <span class="neon-text-pink">♪</span>
            <span class="text-gray-200"><%= member.name %></span>
            <% if member == @team.organizer %>
              <span class="text-xs bg-neon-purple/20 text-neon-purple px-2 py-1 rounded border border-neon-purple/30">organisateur</span>
            <% end %>
          </div>
          <% if @team.organizer == current_user && member != @team.organizer %>
            <%= button_to "Retirer", team_membership_path(@team, @team.memberships.find_by(user: member)), method: :delete, data: { turbo_confirm: "Retirer #{member.name} de l'équipe ?" }, class: "neon-text-pink hover:opacity-80 text-sm transition-all duration-300 cursor-pointer" %>
          <% end %>
        </div>
      <% end %>
    </div>

    <% if @team.organizer == current_user %>
      <div class="mt-4 pt-4 border-t border-neon-purple/20">
        <h3 class="text-sm font-medium text-gray-300 mb-2">Ajouter un membre</h3>
        <%= form_with url: team_memberships_path(@team), method: :post, class: "flex gap-2" do |f| %>
          <%= f.email_field :email, placeholder: "Email du membre à ajouter", class: "input-neon flex-1 px-4 py-2 rounded-lg text-gray-100 text-sm focus:outline-none transition-all duration-300", required: true %>
          <%= f.submit "+ Ajouter", class: "btn-neon btn-primary px-4 py-2 rounded-lg text-sm cursor-pointer" %>
        <% end %>
      </div>
    <% end %>
  </div>

  <%# Games Section %>
  <div class="neon-border p-6">
    <div class="flex justify-between items-center mb-4">
      <h2 class="font-display text-lg font-semibold neon-text-pink">Parties récentes</h2>
      <% if @team.organizer == current_user %>
        <% if @team.has_active_game? %>
          <span class="group relative inline-block">
            <span class="btn-neon btn-primary px-4 py-2 rounded-lg text-sm font-medium flex items-center gap-2 opacity-50 cursor-not-allowed">
              🎮 Lancer une partie
            </span>
            <span class="absolute bottom-full left-1/2 transform -translate-x-1/2 mb-2 px-3 py-1 bg-gray-900 text-gray-200 text-xs rounded whitespace-nowrap invisible group-hover:visible border border-neon-purple/30">
              Une partie est déjà en cours
            </span>
          </span>
        <% else %>
          <%= link_to new_team_game_path(@team), class: "btn-neon btn-primary px-4 py-2 rounded-lg text-sm font-medium flex items-center gap-2" do %>
            🎮 Lancer une partie
          <% end %>
        <% end %>
      <% end %>
    </div>

    <%# Active game indicator %>
    <% if @team.has_active_game? %>
      <div class="mb-4 p-3 bg-neon-cyan/10 border border-neon-cyan/30 rounded-lg">
        <span class="neon-text-cyan">▶</span>
        <span class="text-gray-200">Partie en cours:</span>
        <%= link_to "Partie ##{@team.active_game.id}", game_path(@team.active_game), class: "neon-text-pink hover:underline ml-1" %>
        <span class="text-xs text-gray-400 ml-2">(<%= @team.active_game.status.humanize %>)</span>
      </div>
    <% end %>

    <% if @games.empty? %>
      <p class="text-gray-500 text-center py-4">Aucune partie pour le moment.</p>
    <% else %>
      <div class="space-y-2">
        <% @games.each do |game| %>
          <div class="flex justify-between items-center py-3 border-b border-neon-purple/20 last:border-0">
            <div>
              <span class="font-medium text-gray-200">Partie #<%= game.id %></span>
              <span class="text-gray-500 text-sm ml-2"><%= l(game.created_at, format: :short) rescue game.created_at.strftime("%d/%m/%Y") %></span>
              <span class="ml-2 text-xs px-2 py-1 rounded border <%= game.finished? ? 'bg-gray-500/20 text-gray-400 border-gray-500/30' : game.guessing? ? 'bg-yellow-500/20 text-yellow-400 border-yellow-500/30' : 'bg-neon-cyan/20 neon-text-cyan border-neon-cyan/30' %>">
                <%= game.status.humanize %>
              </span>
            </div>
            <div class="flex gap-3">
              <%= link_to "Voir", game_path(game), class: "neon-text-cyan hover:neon-text-pink text-sm transition-all duration-300" %>
              <% if game.finished? %>
                <%= link_to "Résultats", game_results_path(game), class: "neon-text-pink hover:neon-text-cyan text-sm transition-all duration-300" %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
