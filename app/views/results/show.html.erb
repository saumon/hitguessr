<div class="max-w-4xl mx-auto">
  <%# Header %>
  <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-3 mb-4 sm:mb-6">
    <div class="flex items-center gap-3 sm:gap-4 min-w-0">
      <%= link_to "← Retour", game_path(@game), class: "text-gray-400 hover:neon-text-cyan transition-all duration-300 text-sm sm:text-base min-h-11 inline-flex items-center flex-shrink-0" %>
      <h1 class="text-lg sm:text-2xl font-display font-bold truncate">
        <span class="neon-text-pink">🏆 Résultats</span>
        <span class="neon-text-cyan hidden sm:inline">- Partie #<%= @game.id %></span>
      </h1>
    </div>
  </div>

  <%# Ranking - Cards layout %>
  <div class="neon-border p-4 sm:p-6 mb-4 sm:mb-6">
    <h2 class="text-lg sm:text-xl font-display font-semibold neon-text-purple mb-3 sm:mb-4">Classement</h2>
    
    <div class="space-y-3">
      <% @ranking.each do |entry| %>
        <% rank = entry[:rank] %>
        <% medal = case rank
                   when 1 then "🥇"
                   when 2 then "🥈"
                   when 3 then "🥉"
                   else "#{rank}."
                   end %>
        <% is_winner = rank == 1 %>
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between p-3 sm:p-4 rounded-lg <%= is_winner ? 'bg-gradient-to-r from-neon-pink/20 to-neon-purple/20 border border-neon-pink/50' : 'bg-dark-700/50 border border-neon-purple/20' %> transition-all duration-300 hover:scale-[1.01] gap-2 sm:gap-0">
          <div class="flex items-center gap-2 sm:gap-3">
            <span class="text-xl sm:text-2xl w-8 sm:w-10 text-center <%= is_winner ? 'pulse-glow' : '' %> flex-shrink-0"><%= medal %></span>
            <span class="font-medium text-sm sm:text-base <%= entry[:player] == current_user ? 'neon-text-cyan' : 'text-gray-200' %> truncate">
              <%= entry[:player].name %>
              <% if entry[:player] == current_user %>
                <span class="text-xs text-neon-cyan/70">(vous)</span>
              <% end %>
            </span>
          </div>
          <div class="text-left sm:text-right pl-10 sm:pl-0">
            <span class="text-xl sm:text-2xl font-bold <%= is_winner ? 'neon-text-pink' : 'text-gray-200' %>"><%= entry[:score] %></span>
            <span class="text-xs sm:text-sm text-gray-500 ml-1">pt<%= entry[:score] > 1 ? 's' : '' %></span>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <%# Detailed results - Cards layout %>
  <div class="neon-border p-4 sm:p-6">
    <h2 class="text-lg sm:text-xl font-display font-semibold neon-text-purple mb-3 sm:mb-4">Détail des propositions</h2>
    
    <div class="space-y-4 sm:space-y-6">
      <% @proposals.each_with_index do |proposal, index| %>
        <div class="border border-neon-purple/30 rounded-lg p-3 sm:p-4 bg-dark-700/50">
          <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-2 mb-3">
            <h3 class="font-medium text-gray-200 text-sm sm:text-base">Proposition #<%= index + 1 %></h3>
            <span class="bg-neon-pink/20 border border-neon-pink/40 neon-text-pink px-3 py-1 rounded-full text-xs sm:text-sm self-start">
              Par: <%= proposal.player.name %>
            </span>
          </div>
          
          <div class="bg-dark-800/50 rounded-lg p-2 sm:p-3 mb-3 sm:mb-4 border border-neon-cyan/20 overflow-hidden">
            <a href="<%= proposal.url %>" target="_blank" rel="noopener noreferrer" class="neon-text-cyan hover:neon-text-pink transition-all duration-300 break-all flex items-start gap-2 text-xs sm:text-sm">
              <span class="flex-shrink-0">🔗</span>
              <span class="truncate sm:whitespace-normal"><%= proposal.url %></span>
            </a>
          </div>

          <% if (embed_html = youtube_embed(proposal.url)) %>
            <div class="mb-3 sm:mb-4">
              <div class="aspect-video w-full">
                <%= embed_html %>
              </div>
            </div>
          <% end %>

          <div class="space-y-2">
            <h4 class="text-xs sm:text-sm font-medium text-gray-400">Devinettes:</h4>
            <% proposal.guesses.each do |guess| %>
              <% is_correct = guess.guessed_author_id == proposal.player_id %>
              <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between py-2 px-3 rounded-lg <%= is_correct ? 'bg-neon-cyan/10' : 'bg-red-500/10' %> text-xs sm:text-sm gap-1 sm:gap-0">
                <span class="<%= guess.player == current_user ? 'neon-text-cyan' : 'text-gray-300' %>">
                  <%= guess.player.name %>
                  <% if guess.player == current_user %>
                    <span class="text-neon-cyan/70">(vous)</span>
                  <% end %>
                </span>
                <span class="flex items-center gap-2">
                  <span class="<%= is_correct ? 'neon-text-cyan' : 'text-red-400' %>">
                    → <%= guess.guessed_author.name %>
                  </span>
                  <span><%= is_correct ? '✅' : '❌' %></span>
                </span>
              </div>
            <% end %>
            <% if proposal.guesses.empty? %>
              <p class="text-xs sm:text-sm text-gray-500 italic">Aucune devinette pour cette proposition</p>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <%# Back to team %>
  <div class="mt-6 sm:mt-8 text-center">
    <%= link_to "← Retour à l'équipe #{@team.name}", team_path(@team), class: "neon-text-pink hover:neon-text-cyan font-medium transition-all duration-300 text-sm sm:text-base min-h-11 inline-flex items-center justify-center" %>
  </div>
</div>
