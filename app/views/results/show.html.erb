<div class="max-w-4xl mx-auto">
  <%# Header %>
  <div class="flex justify-between items-center mb-6">
    <div class="flex items-center gap-4">
      <%= link_to "← Retour", game_path(@game), class: "text-gray-400 hover:neon-text-cyan transition-all duration-300" %>
      <h1 class="text-2xl font-display font-bold">
        <span class="neon-text-pink">🏆 Résultats</span>
        <span class="neon-text-cyan">- Partie #<%= @game.id %></span>
      </h1>
    </div>
  </div>

  <%# Ranking %>
  <div class="neon-border p-6 mb-6">
    <h2 class="text-xl font-display font-semibold neon-text-purple mb-4">Classement</h2>
    
    <div class="space-y-3">
      <% @ranking.each do |entry| %>
        <% rank = entry[:rank] %>
        <% medal = case rank
                   when 1 then "🥇"
                   when 2 then "🥈"
                   when 3 then "🥉"
                   else "#{rank}."
                   end %>
        <% is_winner = rank == 1 %>
        <div class="flex items-center justify-between p-4 rounded-lg <%= is_winner ? 'bg-gradient-to-r from-neon-pink/20 to-neon-purple/20 border border-neon-pink/50' : 'bg-dark-700/50 border border-neon-purple/20' %> transition-all duration-300 hover:scale-[1.01]">
          <div class="flex items-center gap-3">
            <span class="text-2xl w-10 text-center <%= is_winner ? 'pulse-glow' : '' %>"><%= medal %></span>
            <span class="font-medium <%= entry[:player] == current_user ? 'neon-text-cyan' : 'text-gray-200' %>">
              <%= entry[:player].name %>
              <% if entry[:player] == current_user %>
                <span class="text-xs text-neon-cyan/70">(vous)</span>
              <% end %>
            </span>
          </div>
          <div class="text-right">
            <span class="text-2xl font-bold <%= is_winner ? 'neon-text-pink' : 'text-gray-200' %>"><%= entry[:score] %></span>
            <span class="text-sm text-gray-500 ml-1">pt<%= entry[:score] > 1 ? 's' : '' %></span>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <%# Detailed results %>
  <div class="neon-border p-6">
    <h2 class="text-xl font-display font-semibold neon-text-purple mb-4">Détail des propositions</h2>
    
    <div class="space-y-6">
      <% @proposals.each_with_index do |proposal, index| %>
        <div class="border border-neon-purple/30 rounded-lg p-4 bg-dark-700/50">
          <div class="flex justify-between items-start mb-3">
            <h3 class="font-medium text-gray-200">Proposition #<%= index + 1 %></h3>
            <span class="bg-neon-pink/20 border border-neon-pink/40 neon-text-pink px-3 py-1 rounded-full text-sm">
              Par: <%= proposal.player.name %>
            </span>
          </div>
          
          <div class="bg-dark-800/50 rounded-lg p-3 mb-4 border border-neon-cyan/20">
            <a href="<%= proposal.url %>" target="_blank" rel="noopener noreferrer" class="neon-text-cyan hover:neon-text-pink transition-all duration-300 break-all flex items-center gap-2">
              <span>🔗</span>
              <span><%= proposal.url %></span>
            </a>
          </div>

          <div class="space-y-2">
            <h4 class="text-sm font-medium text-gray-400">Devinettes:</h4>
            <% proposal.guesses.each do |guess| %>
              <% is_correct = guess.guessed_author_id == proposal.player_id %>
              <div class="flex items-center justify-between py-2 px-3 rounded-lg <%= is_correct ? 'bg-neon-cyan/10' : 'bg-red-500/10' %> text-sm">
                <span class="<%= guess.player == current_user ? 'neon-text-cyan' : 'text-gray-300' %>">
                  <%= guess.player.name %>
                  <% if guess.player == current_user %>
                    <span class="text-neon-cyan/70">(vous)</span>
                  <% end %>
                </span>
                <span class="flex items-center gap-2">
                  <span class="<%= is_correct ? 'neon-text-cyan' : 'text-red-400' %>">
                    → <%= guess.guessed_author.name %>
                  </span>
                  <span><%= is_correct ? '✅' : '❌' %></span>
                </span>
              </div>
            <% end %>
            <% if proposal.guesses.empty? %>
              <p class="text-sm text-gray-500 italic">Aucune devinette pour cette proposition</p>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <%# Back to team %>
  <div class="mt-8 text-center">
    <%= link_to "← Retour à l'équipe #{@team.name}", team_path(@team), class: "neon-text-pink hover:neon-text-cyan font-medium transition-all duration-300" %>
  </div>
</div>
