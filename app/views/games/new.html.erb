<div class="max-w-md mx-auto">
  <div class="mb-6">
    <%= link_to "← #{@team.name}", team_path(@team), class: "neon-text-cyan hover:neon-text-pink transition-all duration-300" %>
  </div>

  <div class="neon-border p-8">
    <div class="text-center mb-6">
      <div class="text-5xl mb-4 pulse-glow neon-text-pink">🎧</div>
      <h1 class="font-display text-2xl font-bold neon-text-cyan">Lancer une partie</h1>
    </div>
    
    <p class="text-gray-400 mb-6 text-center">
      Une nouvelle partie va être créée pour l'équipe <strong class="neon-text-pink"><%= @team.name %></strong>.
      <br><br>
      Les membres de l'équipe pourront ensuite soumettre leurs propositions musicales.
    </p>

    <div class="bg-dark-800/80 border border-neon-purple/30 rounded-lg p-4 mb-6">
      <h3 class="font-medium neon-text-purple mb-3">Membres de l'équipe (<%= @team.members.count %>)</h3>
      <ul class="text-sm text-gray-300 space-y-2">
        <% @team.members.each do |member| %>
          <li class="flex items-center gap-2">
            <span class="neon-text-cyan">♪</span>
            <span><%= member.name %></span>
          </li>
        <% end %>
      </ul>
    </div>

    <% if @team.has_active_game? %>
      <div class="mb-4 p-3 bg-dark-800/80 border border-neon-purple/30 rounded-lg text-sm text-gray-300">
        <%= t("games.create.active_game_in_progress") %>
      </div>
      <button type="button" class="btn-neon btn-primary w-full font-semibold py-3 px-4 rounded-lg opacity-50 cursor-not-allowed" disabled aria-disabled="true">
        Lancer la partie
      </button>
    <% elsif !@team.eligible_to_start_game? %>
      <div class="mb-4 p-3 bg-dark-800/80 border border-neon-purple/30 rounded-lg text-sm text-gray-300">
        <%= t("games.create.minimum_members_required", count: Game::MINIMUM_TEAM_MEMBERS) %>
      </div>
      <button type="button" class="btn-neon btn-primary w-full font-semibold py-3 px-4 rounded-lg opacity-50 cursor-not-allowed" disabled aria-disabled="true">
        Lancer la partie
      </button>
    <% else %>
      <%= form_with model: [@team, @game] do |f| %>
        <%= f.submit "Lancer la partie", class: "btn-neon btn-primary w-full font-semibold py-3 px-4 rounded-lg cursor-pointer" %>
      <% end %>
    <% end %>
  </div>
</div>
