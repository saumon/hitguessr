<div class="max-w-4xl mx-auto">
  <%# Header %>
  <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-3 sm:gap-4 mb-6 sm:mb-8">
    <div class="flex items-center gap-3 sm:gap-4 min-w-0">
      <%= link_to "← Équipe", team_path(@team), class: "neon-text-cyan hover:neon-text-pink transition-all duration-300 text-sm sm:text-base min-h-11 inline-flex items-center flex-shrink-0" %>
      <h1 class="font-display text-lg sm:text-2xl font-bold neon-text-pink truncate">Partie #<%= @game.team_game_number %> - <%= @team.name %></h1>
    </div>
  </div>

  <%# Phase indicator %>
  <% case @game.status %>
  <% when "collecting" %>
    <%= render "games/collecting", game: @game, team: @team, proposals: @proposals, my_proposal: @my_proposal, members: @members, players_with_proposals: @players_with_proposals %>
  <% when "guessing" %>
    <%= render "games/guessing", game: @game, team: @team, proposals: @proposals, my_proposal: @my_proposal, players_with_guesses: @players_with_guesses %>
  <% when "finished" %>
    <%= render "games/finished", game: @game, team: @team %>
  <% end %>
</div>
