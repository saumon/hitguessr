<%# Phase: Terminée %>

<div class="bg-neon-pink/10 border border-neon-pink/30 rounded-lg p-4 mb-6">
  <div class="flex items-center gap-3">
    <span class="text-3xl pulse-glow neon-text-pink">✅</span>
    <div>
      <h2 class="font-display font-semibold neon-text-pink">PARTIE TERMINÉE</h2>
      <p class="text-sm text-gray-400">
        <% if game.finished_at %>
          Terminée le <%= game.finished_at.strftime("%d/%m/%Y à %H:%M") %>
        <% end %>
      </p>
    </div>
  </div>
</div>

<div class="neon-border p-8 text-center">
  <p class="text-gray-300 mb-6 text-lg">La partie est terminée. Découvrez les résultats !</p>
  <%= link_to game_results_path(game), class: "btn-neon btn-primary inline-flex items-center gap-2 font-medium py-3 px-8 rounded-lg text-lg" do %>
    🏆 Voir les résultats
  <% end %>
</div>
