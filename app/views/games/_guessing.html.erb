<%# Phase: Devinettes %>

<div class="bg-neon-purple/10 border border-neon-purple/30 rounded-lg p-4 mb-6">
  <div class="flex items-center gap-3">
    <span class="text-3xl pulse-glow neon-text-purple">🎯</span>
    <div>
      <h2 class="font-display font-semibold neon-text-purple">PHASE: Devinettes</h2>
      <p class="text-sm text-gray-400">Associez chaque musique à son auteur</p>
    </div>
  </div>
</div>

<%# Progress bar %>
<% players_count = proposals.count %>
<% guesses_submitted = proposals.first&.game&.guesses&.select(:player_id)&.distinct&.count || 0 %>
<% # Count unique players who have submitted guesses for this game %>
<% submitted_players = Guess.joins(:proposal).where(proposals: { game_id: game.id }).select(:player_id).distinct.count %>
<% progress_pct = players_count > 0 ? (submitted_players.to_f / players_count * 100).round : 0 %>

<div class="neon-border p-6 mb-6">
  <h3 class="font-medium text-gray-300 mb-3">Progression: <%= submitted_players %>/<%= players_count %> joueurs ont répondu</h3>
  <div class="w-full bg-dark-700 rounded-full h-4 overflow-hidden">
    <div class="bg-gradient-to-r from-neon-purple to-neon-pink h-4 rounded-full transition-all duration-500" style="width: <%= progress_pct %>%"></div>
  </div>
  <p class="text-sm text-gray-500 mt-2"><%= progress_pct %>%</p>
</div>

<%# My guesses action %>
<% my_guesses = current_user.guesses.joins(:proposal).where(proposals: { game_id: game.id }) %>
<% has_submitted_guesses = my_guesses.count == (proposals.count - 1) && my_proposal.present? %>

<div class="neon-border p-6 mb-6">
  <% if !my_proposal %>
    <div class="text-gray-400 flex items-center gap-3">
      <span class="text-xl">⚠️</span>
      <span>Vous n'avez pas soumis de proposition pour cette partie.</span>
    </div>
  <% elsif has_submitted_guesses %>
    <div class="flex items-center gap-3 neon-text-cyan">
      <span class="text-2xl">✅</span>
      <span class="font-medium">Mes devinettes: Soumises</span>
    </div>
    <p class="text-sm text-gray-400 mt-3">Attendez que tous les joueurs aient répondu...</p>
  <% else %>
    <%= link_to new_game_guess_path(game), class: "btn-neon btn-primary inline-flex items-center gap-2 font-medium py-3 px-6 rounded-lg" do %>
      🎯 Faire mes devinettes
    <% end %>
  <% end %>
</div>

<%# Organizer actions %>
<% if team.organizer == current_user %>
  <div class="border-t border-neon-purple/20 pt-6">
    <p class="text-sm text-gray-500 mb-3">(Organisateur uniquement)</p>
    <div class="flex flex-wrap gap-3">
      <%= button_to "⚠️ Terminer la partie", finish_game_path(game), method: :patch, data: { turbo_confirm: "Terminer la partie ? Les joueurs sans réponse auront un score de 0." }, class: "btn-neon btn-danger font-medium py-2 px-4 rounded-lg cursor-pointer" %>
      <%= button_to "🗑️ Annuler la partie", game_path(game), method: :delete, data: { turbo_confirm: t("games.destroy.confirm") }, class: "btn-neon bg-red-500/20 hover:bg-red-500/30 text-red-400 border border-red-500/50 font-medium py-2 px-4 rounded-lg cursor-pointer transition-all duration-300" %>
    </div>
    <p class="text-xs text-gray-500 mt-2">Les joueurs sans réponse auront un score de 0</p>
  </div>
<% end %>
