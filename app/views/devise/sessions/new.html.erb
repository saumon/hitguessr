<div class="max-w-md mx-auto px-4 sm:px-0">
  <div class="neon-border p-4 sm:p-8">
    <div class="text-center mb-6 sm:mb-8">
      <div class="text-4xl sm:text-5xl mb-3 sm:mb-4 pulse-glow inline-block neon-text-pink">♪</div>
      <h2 class="font-display text-xl sm:text-2xl font-bold neon-text-cyan mt-2">Connexion</h2>
      <p class="text-gray-500 mt-2 text-sm sm:text-base">Bienvenue sur HitGuessr !</p>
    </div>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="mb-4 sm:mb-5">
        <%= f.label :email, "Email", class: "block text-sm font-medium text-gray-300 mb-2" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "input-neon w-full px-4 py-3 rounded-lg text-gray-100 focus:outline-none transition-all duration-300 min-h-11", placeholder: "votre@email.com" %>
      </div>

      <div class="mb-4 sm:mb-5">
        <%= f.label :password, "Mot de passe", class: "block text-sm font-medium text-gray-300 mb-2" %>
        <%= f.password_field :password, autocomplete: "current-password", class: "input-neon w-full px-4 py-3 rounded-lg text-gray-100 focus:outline-none transition-all duration-300 min-h-11", placeholder: "••••••••" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="mb-5 sm:mb-6 flex items-center min-h-11">
          <%= f.check_box :remember_me, class: "w-5 h-5 sm:w-4 sm:h-4 bg-dark-800 border-neon-purple/50 rounded text-neon-purple focus:ring-neon-purple" %>
          <%= f.label :remember_me, "Se souvenir de moi", class: "ml-2 text-sm text-gray-400" %>
        </div>
      <% end %>

      <div class="mb-4">
        <%= f.submit "Se connecter", class: "btn-neon btn-primary w-full text-white font-semibold py-3 px-4 rounded-lg transition-all duration-300 cursor-pointer min-h-11" %>
      </div>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</div>
