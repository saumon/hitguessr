<div class="max-w-md mx-auto px-4 sm:px-0">
  <div class="neon-border p-4 sm:p-8">
    <div class="text-center mb-5 sm:mb-6">
      <div class="text-4xl sm:text-5xl mb-3 sm:mb-4 pulse-glow inline-block" style="color: #bf00ff;">🔐</div>
      <h2 class="font-display text-xl sm:text-2xl font-bold text-neon-purple neon-text-subtle mt-2">Mot de passe oublié ?</h2>
      <p class="text-gray-400 mt-1 text-sm sm:text-base">Entrez votre email pour recevoir les instructions</p>
    </div>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="mb-5 sm:mb-6">
        <%= f.label :email, "Email", class: "block text-sm font-medium text-gray-300 mb-1" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "input-neon w-full px-4 py-3 bg-dark-700 border border-dark-500 rounded-lg text-gray-100 placeholder-gray-500 focus:outline-none transition-all duration-300 min-h-11" %>
      </div>

      <div class="mb-4">
        <%= f.submit "Envoyer les instructions", class: "btn-neon w-full bg-gradient-to-r from-neon-purple to-neon-blue text-white font-semibold py-3 px-4 rounded-lg transition-all duration-300 cursor-pointer hover:shadow-lg hover:shadow-neon-purple/30 min-h-11" %>
      </div>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</div>
