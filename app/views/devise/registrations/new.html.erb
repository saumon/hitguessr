<div class="max-w-md mx-auto">
  <div class="neon-border p-8">
    <div class="text-center mb-8">
      <div class="text-5xl mb-4 pulse-glow inline-block neon-text-cyan">♫</div>
      <h2 class="font-display text-2xl font-bold neon-text-pink mt-2">Inscription</h2>
      <p class="text-gray-500 mt-2">Créez votre compte HitGuessr</p>
    </div>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="mb-5">
        <%= f.label :name, "Nom", class: "block text-sm font-medium text-gray-300 mb-2" %>
        <%= f.text_field :name, autofocus: true, autocomplete: "name", class: "input-neon w-full px-4 py-3 rounded-lg text-gray-100 focus:outline-none transition-all duration-300", placeholder: "Votre pseudo" %>
      </div>

      <div class="mb-5">
        <%= f.label :email, "Email", class: "block text-sm font-medium text-gray-300 mb-2" %>
        <%= f.email_field :email, autocomplete: "email", class: "input-neon w-full px-4 py-3 rounded-lg text-gray-100 focus:outline-none transition-all duration-300", placeholder: "votre@email.com" %>
      </div>

      <div class="mb-5">
        <%= f.label :password, "Mot de passe", class: "block text-sm font-medium text-gray-300 mb-2" %>
        <% if @minimum_password_length %>
          <p class="text-xs text-gray-500 mb-2"><%= @minimum_password_length %> caractères minimum</p>
        <% end %>
        <%= f.password_field :password, autocomplete: "new-password", class: "input-neon w-full px-4 py-3 rounded-lg text-gray-100 focus:outline-none transition-all duration-300", placeholder: "••••••••" %>
      </div>

      <div class="mb-6">
        <%= f.label :password_confirmation, "Confirmer le mot de passe", class: "block text-sm font-medium text-gray-300 mb-2" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "input-neon w-full px-4 py-3 rounded-lg text-gray-100 focus:outline-none transition-all duration-300", placeholder: "••••••••" %>
      </div>

      <div class="mb-4">
        <%= f.submit "S'inscrire", class: "btn-neon btn-primary w-full text-white font-semibold py-3 px-4 rounded-lg transition-all duration-300 cursor-pointer" %>
      </div>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</div>
